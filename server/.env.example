# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/signature-bites

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# UPI payment (customers pay to this VPA via the QR code)
UPI_ID=sarngalsaumya@okaxis
UPI_PAYEE_NAME=Signature Bites

# Shown in the website footer as a tap-to-call number (leave empty to hide it)
BUSINESS_PHONE=7780840484

# Gemini (https://aistudio.google.com/apikey). Without a key the chatbot still works using keyword search only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Allowed browser origin during development (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
